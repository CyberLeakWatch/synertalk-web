{
  "name": "synertalk-web-tailwind",
  "private": true,
  "description": "Compila assets/tailwind.css a partir de las clases usadas en index.html",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i input.css -o ../../assets/tailwind.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i input.css -o ../../assets/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
